# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from the github/gitignore repository:
# https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures store used by Memory Profiler
/[Mm]emoryCaptures/

# Recordings store used by Unity Recording API
/[Rr]ecordings/

# Asset server cache
/[Aa]sset_Server[Cc]ache/

# Visual Studio / VS Code / Rider cache and generated project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.slnx

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local agent / Unity MCP client configuration (machine-specific, not shared)
.agents/
.kitwright/
opencode.json

# Asset Store packs imported for evaluation; trimmed subset gets committed
# when a feature actually uses it (339 MB pack - do not commit wholesale).
/Assets/InnerverseInteractive/
/Assets/InnerverseInteractive.meta

