%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 77fc5792932273fd281964634a89513f, type: 3}
  m_Name: DownyBirch
  m_EditorClassIdentifier: Assembly-CSharp::TreeSpeciesDefinition
  speciesId: downy-birch
  displayName: Downy birch
  latinName: Betula pubescens
  # [HOLD] Scenario Two species foundation: growth is deliberately NOT set (no held equations for this species).
  # The four numbers below are inert sentinels (0 / 1), not values; ignored while growthState is Hold (3).
  # See Docs/ScenarioTwoSpeciesFoundation.md.
  potentialDbhGrowthCmPerYear: 0
  maxDbhCm: 1
  potentialHeightGrowthMPerYear: 0
  maxHeightM: 1
  ci50: 3
  # [ORD] Intermediate: user-accepted ORDINAL PLACEHOLDER for density class (not a measured density coefficient). Reference is reserved for sitka-spruce.
  growingSpaceDemand: 1
  # [HOLD] Crown, form and Ci50 follow growthState: not set. Defaults left in place are inert while growth is on Hold.
  crownRadiusIntercept: 0.9415
  crownRadiusPerCmDbh: 0.07635
  usePowerLawCrown: 0
  crownAreaLogIntercept: 0.05
  crownAreaLogSlope: 1.01
  crownRelaxationPerYear: 0.15
  formHeightRatio: 0.5
  # [A, GB, provisional] Seed production from about age 15 (Forest Research). Full-fecundity ramp is OPEN: full = onset is the no-ramp placeholder (a step), not a measured ramp [C].
  maturityOnsetYears: 15
  maturityFullYears: 15
  seedPotentialPerMatureTree: 1
  # [C placeholder] Single conservative scale. Anchors (A, GB): mean seed movement 38 m in a closed stand, 65 m open (Liu & Evans 2021, Forests 12:929; B. pendula and B. pubescens pooled).
  # Closed-stand anchor chosen: lambda = mean / 2 = 19 m under the existing exp(-d/lambda) 2-D convention (mean distance = 2 lambda). Cutoff 150 m is a performance abstraction (~0.3 % of the kernel beyond it).
  seedDispersalScaleM: 19
  seedDispersalCutoffM: 150
  # [C neutral] No interannual mast variation modelled: Forest Research says good crops almost every year after onset; magnitude and variation are OPEN. 0 / 0 with multiplier 1 = every year normal.
  mastGoodProbability: 0
  mastPoorProbability: 0
  mastGoodMultiplier: 1
  mastNormalMultiplier: 1
  mastPoorMultiplier: 1
  seedSaturationS50: 5
  lightResponseLight:
  - 0
  - 0.1
  - 0.2
  - 0.25
  - 0.55
  - 1
  lightResponseFactor:
  - 0
  - 0.1
  - 0.3
  - 0.5
  - 0.9
  - 0.8
  # [HOLD] juvenileLightState Hold (3): juvenile light response is not set; the arrays above are the inert legacy defaults.
  # Alder reports ~5 % light for establishment and ~20 % for survival (USDA Silvics, not Irish): a RANGE for a calibration packet, not entered.
  useDistinctJuvenileLightResponses: 0
  survivalResponseLight:
  - 0
  - 1
  survivalResponseFactor:
  - 1
  - 1
  establishmentResponseLight:
  - 0
  - 1
  establishmentResponseFactor:
  - 1
  - 1
  regenHeightGrowthMPerYear: 0.35
  promotionHeightM: 3.5
  promotionMinimumLight: 0
  regenInitialHeightM: 0.15
  regenDensityPerEstablishment: 0.5
  regenDensityMax: 1.5
  regenMortalityUnderPoorLight: 0.2
  regenPoorLightThreshold: 0.15
  supportsRegeneration: 1
  # [SET, C] Browsing v1 initial value 0.5 (low-moderate); broadleaf heights 1.2 / 1.8 m are the Browsing v1 abstraction. Palatability is not damage.
  browsePalatability: 0.5
  browseFullVulnerabilityHeightM: 1.2
  browseEscapeHeightM: 1.8
  # Explicit configuration states: 0 Unspecified, 1 Set, 2 Placeholder, 3 Hold. naturalSeedDispersal: 1 None (planting-only), 2 Wind, 3 WindAndWater.
  growthState: 3
  growthAgePhases: []
  browseState: 1
  juvenileLightState: 3
  naturalSeedDispersal: 2
  seedKernelState: 2
  standWindSusceptibility: 1
  windOpeningWeight: 1
  windThinningHalfLifeYears: 3
