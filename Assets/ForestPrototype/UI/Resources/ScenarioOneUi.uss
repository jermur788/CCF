/* Scenario One UI tokens and layout primitives. Visual reference: the accepted
   CCF UI mockups (dark translucent panels, compact semantic colour). Colours
   always pair with text; meaning never depends on colour alone. */

:root {
    --panel-bg: rgba(14, 22, 16, 0.86);
    --panel-border: rgba(160, 190, 150, 0.22);
    --frame-bg: rgb(14, 22, 16);
    --frame-border: rgba(176, 204, 160, 0.42);
    --frame-rule: rgba(160, 190, 150, 0.20);
    --backdrop: rgba(3, 7, 4, 0.66);
    --ink: rgb(236, 240, 228);
    --ink-muted: rgb(176, 190, 168);
    --ink-faint: rgb(132, 146, 126);
    --accent: rgb(232, 206, 120);
    --good: rgb(150, 214, 140);
    --warn: rgb(240, 186, 110);
    --bad: rgb(236, 128, 112);
    --fell: rgb(214, 70, 58);
    --crop: rgb(70, 130, 230);
    --rack: rgb(182, 118, 232);
    --chip-bg: rgba(255, 255, 255, 0.08);
    --btn-bg: rgba(60, 86, 58, 0.95);
    --btn-bg-hover: rgba(86, 122, 82, 1);
    --btn-bg-active: rgba(44, 66, 44, 1);
    --btn-border: rgba(170, 200, 150, 0.40);
}

.root { flex-grow: 1; color: var(--ink); font-size: 15px; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.panel {
    background-color: var(--panel-bg);
    border-color: var(--panel-border);
    border-width: 1px;
    border-radius: 6px;
    padding: 10px 14px;
}

.title { font-size: 22px; -unity-font-style: bold; color: var(--ink); }
.subtitle { font-size: 15px; color: var(--ink-muted); }
.heading { font-size: 16px; -unity-font-style: bold; color: var(--accent); margin-top: 6px; margin-bottom: 4px; }
.body { white-space: normal; color: var(--ink); }
.muted { white-space: normal; color: var(--ink-muted); font-size: 16px; }
.faint { white-space: normal; color: var(--ink-faint); font-size: 15px; }
.money { -unity-font-style: bold; color: var(--good); }
.money-negative { -unity-font-style: bold; color: var(--bad); }
.value { -unity-font-style: bold; color: var(--ink); }

.row { flex-direction: row; align-items: center; }
.row-wrap { flex-direction: row; flex-wrap: wrap; }
.spread { flex-direction: row; justify-content: space-between; align-items: center; }
.grow { flex-grow: 1; }
.gap { margin-right: 10px; }

.chip {
    background-color: var(--chip-bg);
    border-radius: 4px;
    padding: 1px 6px;
    margin-right: 6px;
    font-size: 13px;
}
.chip-fell { background-color: rgba(214, 70, 58, 0.85); color: white; -unity-font-style: bold; }
.chip-crop { background-color: rgba(70, 130, 230, 0.85); color: white; -unity-font-style: bold; }
.chip-rack { background-color: rgba(150, 90, 206, 0.9); color: white; -unity-font-style: bold; }
.chip-ok { background-color: rgba(90, 160, 90, 0.75); color: white; }
.chip-warn { background-color: rgba(200, 140, 50, 0.8); color: white; }
.chip-bad { background-color: rgba(190, 70, 60, 0.85); color: white; }

.key { color: var(--accent); -unity-font-style: bold; }

/* ---- buttons ---- */
/* Every state is spelled out: the default runtime theme has its own hover/active/focus colours, and without these a hovered or
   pressed button could show the theme's pale grey instead of this palette (the selected map tab read as white on white). */
.btn {
    background-color: var(--btn-bg);
    border-color: var(--btn-border);
    border-width: 1px;
    border-radius: 5px;
    color: var(--ink);
    padding: 5px 12px;
    margin: 2px 6px 2px 0;
    min-height: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 14px;
    flex-shrink: 0;
}
.btn:hover { background-color: var(--btn-bg-hover); color: var(--ink); }
.btn:active { background-color: var(--btn-bg-active); color: var(--ink); }
.btn:focus { color: var(--ink); }
.btn:disabled { opacity: 0.45; }
.btn-primary { background-color: rgba(122, 104, 44, 0.97); border-color: rgba(232, 206, 120, 0.70); }
.btn-primary:hover { background-color: rgba(150, 128, 54, 1); color: var(--ink); }
.btn-primary:active { background-color: rgba(100, 84, 34, 1); color: var(--ink); }
.btn-selected { background-color: rgba(96, 134, 90, 1); border-color: var(--accent); border-width: 2px; color: white; }
.btn-selected:hover { background-color: rgba(108, 148, 102, 1); color: white; }
.btn-selected:active { background-color: rgba(78, 112, 74, 1); color: white; }
.btn-ghost { background-color: rgba(255, 255, 255, 0.04); border-color: var(--frame-rule); }
.btn-ghost:hover { background-color: rgba(255, 255, 255, 0.10); }

.card {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: var(--panel-border);
    border-width: 1px;
    border-radius: 4px;
    padding: 8px 10px;
    margin-bottom: 8px;
}

.table-row { flex-direction: row; padding: 1px 0; }
.table-row Label { white-space: normal; }
.cell-name { flex-grow: 3; flex-basis: 0; }
.cell-num { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-right; }
/* Line() values never wrap (a wrapped sign would split from its amount). */
.line-value { flex-shrink: 0; white-space: nowrap; margin-left: 10px; -unity-text-align: middle-right; }
/* A Line() whose value is a sentence rather than a figure: the value sits under the name instead of squeezing it
   into a column a syllable wide. */
.table-row-stacked { flex-direction: column; }
.table-row-stacked .cell-name { flex-grow: 0; flex-basis: auto; }
.table-row-stacked .line-value { margin-left: 0; -unity-text-align: upper-left; }

/* ---- scroll bars (Work Plan, Annual Review, Help, Learning objectives) ---- */
/* A slim track with a soft rounded thumb in the panel palette; the arrow buttons are dropped (the wheel and the thumb scroll). */
.unity-scroll-view__vertical-scroller { width: 12px; margin-left: 6px; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-scroll-view__vertical-scroller .unity-scroller__slider { margin: 0; }
.unity-scroll-view__vertical-scroller .unity-repeat-button { display: none; }
.unity-scroll-view__vertical-scroller .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.06); border-width: 0; border-radius: 6px; width: 8px; margin-left: 2px;
}
.unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    background-color: rgba(170, 198, 156, 0.42); border-width: 0; border-radius: 6px; width: 8px; margin-left: 2px; min-height: 28px;
}
.unity-scroll-view__vertical-scroller .unity-base-slider__dragger:hover { background-color: rgba(196, 220, 182, 0.70); }
.unity-scroll-view__vertical-scroller .unity-base-slider__dragger:active { background-color: rgba(220, 238, 206, 0.85); }
.unity-scroll-view__horizontal-scroller { display: none; }

/* ---- walking HUD ---- */
/* Both side columns share one width so the status panel, the felling estimate and the competitor list line up. */
.hud-status { position: absolute; top: 14px; right: 14px; width: 400px; }
/* The title carries the year, phase and intervention count; it wraps rather than cutting the count off. */
.hud-status .heading { white-space: normal; }
/* The right edge leaves the bottom-right corner to the minimap. */
.hud-bottom { position: absolute; left: 14px; bottom: 12px; right: 232px; }
.hud-ground { max-width: 560px; margin-bottom: 8px; }
.hud-prompt {
    position: absolute; left: 0; right: 0; top: 56%;
    align-items: center;
}
.hud-prompt-box { -unity-text-align: middle-center; font-size: 18px; -unity-font-style: bold; white-space: normal; max-width: 900px; }
.hud-message { position: absolute; top: 14px; left: 0; right: 0; align-items: center; }
.hud-message Label { font-size: 18px; color: var(--accent); -unity-font-style: bold; white-space: normal; max-width: 900px; -unity-text-align: middle-center; }
.reticle { position: absolute; left: 50%; top: 50%; width: 4px; height: 4px; margin-left: -2px; margin-top: -2px; background-color: rgba(255, 255, 255, 0.8); }
.hud-hotbar { margin-top: 8px; align-items: center; align-self: flex-end; margin-right: 14px; max-width: 900px; }
.hud-waypoint { position: absolute; top: 14px; left: 50%; width: 400px; margin-left: -200px; border-color: var(--accent); }
.waypoint-line { color: var(--accent); font-size: 18px; -unity-font-style: bold; }

/* ---- HUD minimap: the Stand Map's map, reduced. Its size is set in HudMinimapView; it takes no pointer input. ---- */
.hud-minimap { position: absolute; right: 14px; bottom: 12px; padding: 4px; }
.hud-minimap-north { position: absolute; left: 0; right: 0; top: 7px; -unity-text-align: upper-center; font-size: 13px; -unity-font-style: bold; color: var(--ink); }

/* ---- inspection ---- */
/* Left column, top-left, clear of the status panel (top-right) and the ground report (bottom-left). The scenario UI root sets the
   maximum height each frame so the card and its detail can never reach the forecast and marking panels at the bottom-left. The
   felling estimate and the competitor list live in the right column, the same width as the status panel. */
.inspect { position: absolute; left: 14px; top: 14px; width: 400px; max-height: 80%; overflow: hidden; }
.inspect * { flex-shrink: 0; }
.inspect-detail { margin-top: 8px; }
.estimate-panel * { flex-shrink: 0; }
.stat-grid { flex-direction: row; flex-wrap: wrap; }
/* Two to a row at any width: a basis a little under half, grown to fill, so rounding can never push the second one down. */
.stat { flex-basis: 46%; flex-grow: 1; margin-bottom: 4px; }
.stat-label { color: var(--ink-faint); font-size: 15px; }
.stat-value { -unity-font-style: bold; font-size: 15px; white-space: normal; }
.inspect-hint { color: var(--ink-muted); font-size: 14px; white-space: normal; margin-top: 4px; }
.inspect-tag {
    -unity-font-style: bold; font-size: 14px; color: rgb(20, 24, 18); background-color: rgba(240, 244, 236, 0.94);
    border-radius: 9px; padding: 0 7px; -unity-text-align: middle-center;
}

/* ---- modal screens ---- */
/* A modal covers the whole screen: it dims everything behind it and takes every pointer event itself, so nothing underneath
   (the forest, the HUD buttons) can be clicked while it is open. */
.modal-backdrop { background-color: var(--backdrop); align-items: center; justify-content: center; }
.modal {
    background-color: var(--frame-bg);
    border-color: var(--frame-border);
    border-width: 1px;
    border-radius: 8px;
    padding: 12px 18px 14px 18px;
    width: 92%; max-width: 1180px; height: 92%; max-height: 900px;
}
.modal-header {
    flex-direction: row; justify-content: space-between; align-items: center;
    margin-bottom: 8px; padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: var(--frame-rule);
}
/* Fixed parts of a modal keep their height; only the scroll view shrinks. */
.modal > * { flex-shrink: 0; }
.modal > .unity-scroll-view { flex-shrink: 1; }
.modal-footer {
    flex-direction: row; flex-wrap: wrap; align-items: center;
    margin-top: 8px; padding-top: 8px; border-top-width: 1px; border-top-color: var(--frame-rule);
}
.columns { flex-direction: row; flex-wrap: wrap; }
.column { flex-grow: 1; flex-basis: 300px; margin-right: 10px; }

/* ---- stand map ---- */
.map-body { flex-direction: row; flex-grow: 1; }
.map-left { flex-grow: 1; align-items: center; }
/* The frame is exactly the map square (size set in StandMapView). The cell buttons are placed in it from the shared map transform,
   and the canvas draws paths, racks, you and the destination over them from the same transform. */
.map-grid { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.map-canvas { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.map-cell {
    margin: 0;
    border-width: 2px; border-color: transparent; border-radius: 2px; padding: 2px 3px;
    justify-content: space-between;
}
.map-cell:hover { border-color: rgba(255, 255, 255, 0.55); }
.map-cell Label {
    font-size: 13px; color: white; -unity-font-style: bold; align-self: flex-start;
    background-color: rgba(0, 0, 0, 0.55); padding: 0 3px; border-radius: 2px; margin-bottom: 1px;
}
.map-cell-selected { border-color: var(--accent); }
.map-cell-player { border-color: white; }
.map-cell-rack { border-color: rgba(190, 126, 240, 0.95); }
.map-side { width: 330px; margin-left: 12px; }
.map-tabs { flex-direction: row; flex-wrap: wrap; margin-bottom: 6px; }
.legend { flex-direction: row; align-items: center; margin-top: 6px; }
.legend-swatch { width: 120px; height: 10px; margin: 0 6px; }

/* ---- help window ---- */
/* Contextual menu teaching: one screen at a time, bounded on small displays. A real window: title bar, scrolling body, button bar. */
.menu-help-panel {
    background-color: var(--frame-bg);
    border-color: var(--frame-border);
    border-width: 1px; border-radius: 8px;
    padding: 0;
    width: 88%; max-width: 680px; max-height: 84%;
}
.menu-help-panel > * { flex-shrink: 0; }
.menu-help-panel > .unity-scroll-view { flex-shrink: 1; }
.menu-help-title {
    padding: 12px 20px; border-bottom-width: 1px; border-bottom-color: var(--frame-rule);
    background-color: rgba(120, 160, 110, 0.10); border-top-left-radius: 8px; border-top-right-radius: 8px;
}
.menu-help-body { padding: 14px 20px 6px 20px; flex-shrink: 1; }
.menu-help-body .body { font-size: 16px; margin-bottom: 10px; }
.menu-help-bar {
    flex-direction: row; align-items: center; justify-content: space-between;
    padding: 10px 20px 12px 20px; border-top-width: 1px; border-top-color: var(--frame-rule);
}
.menu-help-bar .btn { margin: 0; min-width: 120px; }
.menu-help-bar .btn-primary { min-width: 200px; }

/* Learning topics reveal one explanation at a time; the body scrolls. */
.learning-topic { margin-top: 8px; margin-bottom: 8px; }
.learning-topic > Toggle { font-size: 18px; color: var(--accent); -unity-font-style: bold; }
.learning-topic .body { margin-bottom: 8px; }

/* ---- Crop Tree competitors (inspection card, world tags) ---- */
.competitor-row Label { font-size: 14px; white-space: nowrap; }
.competitor-name { flex-grow: 2.2; flex-basis: 0; }
.competitor-num { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-right; margin-right: 6px; }
.competitor-share { flex-grow: 2; flex-basis: 0; }
.competitor-selected Label { color: var(--accent); -unity-font-style: bold; }
.competitor-tag {
    width: 24px; height: 24px;
    font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center;
    color: rgb(20, 24, 18);
    background-color: rgba(232, 206, 120, 0.92);
    border-radius: 12px;
}
.competitor-tag-selected { background-color: white; border-width: 2px; border-color: var(--accent); }
.hud-forecast { max-width: 900px; }

/* ---- extraction racks ---- */
.rack-panel { border-color: rgba(190, 126, 240, 0.7); }
.rack-heading { white-space: normal; font-size: 16px; -unity-font-style: bold; color: rgb(206, 156, 246); margin-bottom: 4px; }
.rack-line { white-space: normal; color: var(--ink); }
.rack-keys { white-space: normal; color: var(--ink-muted); font-size: 14px; margin-top: 4px; }
