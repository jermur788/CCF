<Project Sdk="Microsoft.NET.Sdk">
  <!--
    #849 UI-A (spec MULTI-STANDMAP-PLAYABLE-2D-V1 §3.2): the single-session, loopback-only presentation process of the
    playable 2D Stand Map. It uses the ASP.NET Core shared framework that is installed with the .NET 8 SDK
    (Microsoft.AspNetCore.App and its targeting pack under ~/.dotnet), so restore downloads no package.

    Build it by this explicit project path. It is deliberately NOT in MultiRackSitkaP1Lab.sln, so the qualified solution
    build graph (Core, CLI, Core tests) is unchanged.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sitkap1-ui</AssemblyName>
    <RootNamespace>SitkaP1.Ui</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Core/SitkaP1.Core.csproj" />
  </ItemGroup>

  <!--
    The page is compiled into the assembly and served from memory, so the running process reads no page file from disk
    and nothing is copied to the output folder. PlayerApi.cs names these three resources exactly.
  -->
  <ItemGroup>
    <None Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/index.html" LogicalName="SitkaP1.Ui.wwwroot.index.html" />
    <EmbeddedResource Include="wwwroot/app.css" LogicalName="SitkaP1.Ui.wwwroot.app.css" />
    <EmbeddedResource Include="wwwroot/app.js" LogicalName="SitkaP1.Ui.wwwroot.app.js" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="multi/**" />
    <EmbeddedResource Include="multi/multi.html" LogicalName="SitkaP1.Ui.multi.multi.html" />
    <EmbeddedResource Include="multi/multi.css" LogicalName="SitkaP1.Ui.multi.multi.css" />
    <EmbeddedResource Include="multi/api.js" LogicalName="SitkaP1.Ui.multi.api.js" />
    <EmbeddedResource Include="multi/commands.js" LogicalName="SitkaP1.Ui.multi.commands.js" />
    <EmbeddedResource Include="multi/dialogs/execute-confirm.js" LogicalName="SitkaP1.Ui.multi.dialogs.execute-confirm.js" />
    <EmbeddedResource Include="multi/dialogs/saves.js" LogicalName="SitkaP1.Ui.multi.dialogs.saves.js" />
    <EmbeddedResource Include="multi/dialogs/woodland.js" LogicalName="SitkaP1.Ui.multi.dialogs.woodland.js" />
    <EmbeddedResource Include="multi/dialogs/woodland-inspection.js" LogicalName="SitkaP1.Ui.multi.dialogs.woodland-inspection.js" />
    <EmbeddedResource Include="multi/dom.js" LogicalName="SitkaP1.Ui.multi.dom.js" />
    <EmbeddedResource Include="multi/main.js" LogicalName="SitkaP1.Ui.multi.main.js" />
    <EmbeddedResource Include="multi/map/contract.js" LogicalName="SitkaP1.Ui.multi.map.contract.js" />
    <EmbeddedResource Include="multi/map/minimap.js" LogicalName="SitkaP1.Ui.multi.map.minimap.js" />
    <EmbeddedResource Include="multi/map/renderer-svg.js" LogicalName="SitkaP1.Ui.multi.map.renderer-svg.js" />
    <EmbeddedResource Include="multi/modes/interactive.js" LogicalName="SitkaP1.Ui.multi.modes.interactive.js" />
    <EmbeddedResource Include="multi/panels/fell-draft.js" LogicalName="SitkaP1.Ui.multi.panels.fell-draft.js" />
    <EmbeddedResource Include="multi/panels/inspector.js" LogicalName="SitkaP1.Ui.multi.panels.inspector.js" />
    <EmbeddedResource Include="multi/panels/time-history.js" LogicalName="SitkaP1.Ui.multi.panels.time-history.js" />
    <EmbeddedResource Include="multi/panels/work-plan.js" LogicalName="SitkaP1.Ui.multi.panels.work-plan.js" />
    <EmbeddedResource Include="multi/store.js" LogicalName="SitkaP1.Ui.multi.store.js" />
  </ItemGroup>

  <!--
    Woodland Inspection Part 2: the built-in real-woodland catalogue is read from the qualified Importer V1 fixtures,
    embedded byte-for-byte from the test folder (never copied or edited), so /multi needs no upload, path or network.
    MultiWoodlandInspection.cs reads them by these logical names; the importer re-checks each ZIP's pinned SHA-256.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../tests/Core/WoodlandImport/Fixtures/Qualified/ATTRIBUTION.json" LogicalName="SitkaP1.Ui.woodland_fixtures.ATTRIBUTION.json" />
    <EmbeddedResource Include="../../tests/Core/WoodlandImport/Fixtures/Qualified/ie-donadea-mhf-subset.dwca.zip" LogicalName="SitkaP1.Ui.woodland_fixtures.ie-donadea-mhf-subset.dwca.zip" />
    <EmbeddedResource Include="../../tests/Core/WoodlandImport/Fixtures/Qualified/lu-mersch-oak-beech-subset.dwca.zip" LogicalName="SitkaP1.Ui.woodland_fixtures.lu-mersch-oak-beech-subset.dwca.zip" />
  </ItemGroup>
</Project>
