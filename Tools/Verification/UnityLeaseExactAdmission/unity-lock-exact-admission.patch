+                sub = os.open(e.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dirfd)
+                try: walk(sub, rel+b'/')
+                finally: os.close(sub)
+                continue
+            if rel == b'.git':  # the worktree's own pointer file
+                if kind != 'file': raise ValueError('lane .git entry is not a regular file')
+                continue
+            if rel in ignored_files and kind == 'file': continue
+            want = entries.get(rel)
+            if want is None: raise ValueError(f'untracked {kind} in the working tree: {name_of(rel)}')
+            mode, oid, size = want
