+                target = os.fsencode(os.readlink(e.name, dir_fd=dirfd))
+                if blob_object_id(io.BytesIO(target), len(target), algo) != oid: raise ValueError(f'tracked symlink target differs from the canonical HEAD blob: {name_of(rel)}')
+            else:
+                if mode == b'120000': raise ValueError(f'tracked symlink was replaced by a regular file: {name_of(rel)}')
+                if rel in pinned: stats['pinned_skipped'] += 1
+                else:
