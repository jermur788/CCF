+def verified_head_inventory(lane, head, algo):
+    """{path bytes: (mode, blob oid)} for every tracked file, derived only from hash-verified commit and tree objects.
+    Deterministic, bounded and iterative (no recursion limit, each distinct tree verified once, cycles impossible after hashing but
+    guarded by the object and entry limits). Raises ValueError for any object that is missing, mistyped, mis-hashed or malformed."""
+    reader = _BatchObjectReader(lane, algo)
+    try:
+        commit = reader.read(head, 'commit')
+        first = commit.split(b'\n', 1)[0].split(b' ')
+        if len(first) != 2 or first[0] != b'tree': raise ValueError('commit object does not start with a tree line')
+        root = first[1].decode(errors='replace')
+        parsed = {}; inventory = {}; stack = [(b'', root)]; tree_bytes = 0
+        while stack:
+            prefix, oid = stack.pop()
+            if oid not in parsed:
+                if len(parsed) >= MAX_GRAPH_OBJECTS: raise ValueError('Git graph has too many tree objects to verify')
+                payload = reader.read(oid, 'tree'); tree_bytes += len(payload)
+                parsed[oid] = parse_tree_payload(payload, reader.hexlen)
+            for mode, name, child in parsed[oid]:
+                path = prefix+name
+                if mode == b'40000': stack.append((path+b'/', child))
+                else: inventory[path] = (mode, child)
+                if len(inventory)+len(stack) > MAX_GRAPH_ENTRIES: raise ValueError('Git graph lists too many entries to verify')
+    finally: reader.close()
+    return root, inventory, {'verified_commit': head, 'verified_trees': len(parsed), 'verified_tree_bytes': tree_bytes}
+
+def blob_object_id(fh, size, algo):
+    """Object id Git would give these raw bytes (`git hash-object --no-filters`). Streams; refuses if the byte count is not `size`."""
+    digest = hashlib.new(algo, b'blob %d\0' % size); count = 0
+    for chunk in iter(lambda: fh.read(1 << 20), b''):
+        count += len(chunk); digest.update(chunk)
+        if count > size: break
+    if count != size: raise ValueError('file changed while it was being read')
+    return digest.hexdigest()
+
+def prove_raw_working_tree(lane, pinned_dirty, allowed_ignored):
+    """F2/F3. Prove from raw bytes alone that the working tree is the canonical HEAD except the pinned dirty paths (checked separately).
+    Reads tree objects with ls-tree (no index, stat data, status or filter), then walks the directory tree through O_NOFOLLOW
+    descriptors. A size difference is used only to refuse sooner; equality is never inferred from size, mtime or the index.
+    Empty untracked directories are tolerated (Git cannot see them and they hold no bytes)."""
+    started = time.monotonic(); algo = object_format(lane)
+    head = git_exact(lane, 'rev-parse', '--verify', 'HEAD^{commit}')[1].strip().decode(errors='replace')
+    root_tree, verified, graph_stats = verified_head_inventory(lane, head, algo)  # N-1: ids re-hashed before any listing is believed
+    entries = parse_ls_tree(git_exact(lane, 'ls-tree', '-r', '-l', '-z', '--full-tree', head)[1])
+    if {p: (m, o) for p, (m, o, n) in entries.items()} != verified:
+        raise ValueError('Git tree listing disagrees with the hash-verified object graph')
+    ignored_dirs = {x[:-1].encode() for x in allowed_ignored if x.endswith('/')}
+    ignored_files = {x.encode() for x in allowed_ignored if not x.endswith('/')}
+    for path in entries:  # a tracked path inside an ignored entry would never be proved (the entry is not walked): ambiguous, refuse
+        if any(path == ig or path.startswith(ig+b'/') for ig in ignored_dirs | ignored_files):
+            raise ValueError('tracked path lies inside an allowed ignored entry: '+path.decode())
+    pinned = {x.encode() for x in pinned_dirty}
+    stats = {'object_format': algo, 'head_tree': root_tree, **graph_stats, 'tracked_files': len(entries), 'hashed_files': 0, 'hashed_bytes': 0, 'pinned_skipped': 0}
+    seen = set(); name_of = lambda rel: rel.decode(errors='replace')
+
+    def walk(dirfd, prefix):
+        with os.scandir(dirfd) as it: items = sorted(it, key=lambda e: e.name)
+        for e in items:
+            name = os.fsencode(e.name); rel = prefix+name
+            if e.is_symlink(): kind = 'symlink'
+            elif e.is_dir(follow_symlinks=False): kind = 'dir'
+            elif e.is_file(follow_symlinks=False): kind = 'file'
+            else: kind = 'special file'
+            if kind == 'dir':
