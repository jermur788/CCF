+def parse_ls_tree(raw):
+    """{path bytes: (mode, object id, size)} from `ls-tree -r -l -z`. Whatever the raw proof cannot judge (submodules, unusual modes,
+    non-UTF-8 or repeated paths, unparseable records) is a refusal rather than a skip."""
+    entries = {}
+    for rec in raw.split(b'\0'):
+        if not rec: continue
+        meta, tab, path = rec.partition(b'\t'); parts = meta.split()
+        if not tab or len(parts) != 4: raise ValueError('unparseable ls-tree record')
+        mode, kind, oid, size = parts
+        if kind != b'blob' or mode not in _TRACKED_MODES: raise ValueError('unsupported tracked entry (submodule or unusual mode): '+path.decode(errors='replace'))
+        if not re.fullmatch(rb'[0-9a-f]{40}|[0-9a-f]{64}', oid) or not size.isdigit(): raise ValueError('unparseable ls-tree record')
+        try: path.decode()
+        except UnicodeDecodeError: raise ValueError('git reported a non-UTF-8 path')
+        if path in entries: raise ValueError('repeated ls-tree path')
+        entries[path] = (mode, oid.decode(), int(size))
+    return entries
