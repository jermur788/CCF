+# N-1 (#343). Git never re-hashes an object when it reads it: a loose or packed object whose bytes were replaced still answers to
+# its old id, so `ls-tree` over such a tree is only as honest as the object store. Admission therefore reads the pinned HEAD commit
+# and every tree reachable from it as raw bytes, re-computes each id (hash of "<type> <size>\0<payload>" under the repository's
+# object format) and only trusts a listing that matches this verified walk. Blob ids need no separate check: they are only ever
+# compared with the hash of the working-tree bytes, and a verified tree names them.
+MAX_GRAPH_OBJECTS = 2_000_000    # distinct commit/tree objects verified; far above CCF's (hundreds), a refusal beyond it
+MAX_GRAPH_ENTRIES = 5_000_000    # inventory size; stops a tiny hash-valid tree DAG from expanding into an enormous listing
+MAX_GRAPH_OBJECT_BYTES = 64 << 20  # one commit or tree payload
+_TREE_BLOB_MODES = (b'100644', b'100755', b'120000')
+
+class _BatchObjectReader:
+    """`git cat-file --batch` driven one object at a time; yields (type, payload) for a FULL object id after checking the hash."""
+    def __init__(self, lane, algo):
+        argv, env = exact_git_invocation(lane, 'cat-file', '--batch')
+        self.algo = algo; self.hexlen = hashlib.new(algo).digest_size * 2
+        try: self.proc = subprocess.Popen(argv, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
+        except OSError as e: raise ValueError(f'git could not run: {e}')
+    def close(self):
+        self.proc.kill(); self.proc.wait()
+        for pipe in (self.proc.stdin, self.proc.stdout):
+            try: pipe.close()
+            except OSError: pass
+    def read(self, oid, want_type):
+        if not re.fullmatch('[0-9a-f]{%d}' % self.hexlen, oid): raise ValueError('malformed object id in the Git graph: '+oid)
+        try:
+            self.proc.stdin.write(oid.encode()+b'\n'); self.proc.stdin.flush()
+            header = self.proc.stdout.readline().split()
+            if len(header) == 2 and header[1] == b'missing': raise ValueError('Git object is missing: '+oid)
+            if len(header) != 3 or header[0].decode(errors='replace') != oid or not header[2].isdigit(): raise ValueError('unparseable cat-file header for '+oid)
+            kind, size = header[1], int(header[2])
+            if kind.decode(errors='replace') != want_type: raise ValueError(f'object {oid} is a {kind.decode(errors="replace")}, expected a {want_type}')
+            if size > MAX_GRAPH_OBJECT_BYTES: raise ValueError(f'object {oid} is unreasonably large ({size} bytes)')
+            payload = self.proc.stdout.read(size)
+            if len(payload) != size or self.proc.stdout.read(1) != b'\n': raise ValueError('truncated cat-file output for '+oid)
+        except OSError as e: raise ValueError(f'cat-file failed: {e}')
+        if hashlib.new(self.algo, kind+b' %d\0' % size + payload).hexdigest() != oid:
+            raise ValueError(f'Git object {oid} content does not match its object id (corrupt or forged {want_type})')
+        return payload
+
+def parse_tree_payload(payload, hexlen):
+    """[(mode, name bytes, oid hex)] from raw tree bytes. Modes other than plain files, symlinks and directories (submodules, odd modes)
+    and names that could escape or alias the working tree are refused, as is a repeated name."""
+    rawlen = hexlen // 2; entries = []; names = set(); i = 0
+    while i < len(payload):
+        sp = payload.find(b' ', i); nul = payload.find(b'\0', sp+1) if sp >= 0 else -1
+        if sp < 0 or nul < 0 or nul+1+rawlen > len(payload): raise ValueError('malformed tree object')
+        mode, name, oid = payload[i:sp], payload[sp+1:nul], payload[nul+1:nul+1+rawlen].hex(); i = nul+1+rawlen
+        if mode not in _TREE_BLOB_MODES and mode != b'40000': raise ValueError('unsupported tree entry mode (submodule or unusual mode): '+name.decode(errors='replace'))
+        if not name or name in (b'.', b'..') or b'/' in name or name.lower() == b'.git': raise ValueError('unsafe tree entry name: '+name.decode(errors='replace'))
+        try: name.decode()
+        except UnicodeDecodeError: raise ValueError('git reported a non-UTF-8 path')
+        if name in names: raise ValueError('repeated tree entry name: '+name.decode())
+        names.add(name); entries.append((mode, name, oid))
+    return entries
